{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {"maxDuration": 300, "includeFiles": "{data/guides.json,public/guide-model.js}"}
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index"},
    {"source": "/guides", "destination": "/index.html"},
    {"source": "/guides/:path*", "destination": "/index.html"},
    {"source": "/research", "destination": "/index.html"}
  ]
}
